{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "revenueCard",
  "position": {
    "x": 20,
    "y": 70,
    "z": 2000,
    "height": 240,
    "width": 300,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "card",
    "query": {
      "queryState": {
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Order Details"
                    }
                  },
                  "Property": "Revenue"
                }
              },
              "queryRef": "Order Details.Revenue",
              "nativeQueryRef": "Revenue"
            }
          ]
        }
      }
    },
    "objects": {
      "labels": [
        {
          "properties": {
            "labelDisplayUnits": {
              "expr": {
                "Literal": {
                  "Value": "1D"
                }
              }
            },
            "labelPrecision": {
              "expr": {
                "Literal": {
                  "Value": "2L"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "24D"
                }
              }
            },
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#2E7D32'"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Total Revenue'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
