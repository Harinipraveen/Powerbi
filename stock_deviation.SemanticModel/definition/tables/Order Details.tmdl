	/// Order freight split across the order's lines in proportion to gross line value
	column 'Allocated Freight' =
			VAR ThisOrder = 'Order Details'[orderID]
			VAR LineGross = 'Order Details'[quantity] * 'Order Details'[unitPrice]
			// ALL over source columns only, so this column does not depend on other calculated columns
			VAR OrderGross =
			    SUMX (
			        FILTER (
			            ALL ( 'Order Details'[orderID], 'Order Details'[productID], 'Order Details'[quantity], 'Order Details'[unitPrice] ),
			            'Order Details'[orderID] = ThisOrder
			        ),
			        'Order Details'[quantity] * 'Order Details'[unitPrice]
			    )
			RETURN DIVIDE ( LineGross, OrderGross ) * RELATED ( Orders[freight] )
		dataType: double
		isHidden
		formatString: #,0.00
		lineageTag: 94c84b3a-eb1f-4bcb-b557-8be8b7044185
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Catalogue list price used as the standard cost basis. Discontinued products are missing from the
	/// Products source, so they fall back to the highest price they were ever sold at.
	column 'List Price' =
			VAR ThisProduct = 'Order Details'[productID]
			RETURN
			    COALESCE (
			        RELATED ( Products[UnitPrice] ),
			        MAXX (
			            FILTER ( ALL ( 'Order Details'[productID], 'Order Details'[unitPrice] ), 'Order Details'[productID] = ThisProduct ),
			            'Order Details'[unitPrice]
			        )
			    )
		dataType: double
		isHidden
		formatString: #,0.00
		lineageTag: 4a22128c-dd03-46c3-9577-f989956382e6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Order Details' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "order_details.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"orderID", Int64.Type}, {"productID", Int64.Type}, {"unitPrice", type number}, {"quantity", Int64.Type}, {"discount", type number}}, "en-US")
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

