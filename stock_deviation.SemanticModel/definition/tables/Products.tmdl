table Products
	lineageTag: eba8a87e-0ca9-4580-a110-f710ee10208c

	measure 'Units In Stock' =
			VAR v = SUM ( Products[UnitsInStock] )
			RETURN IF ( v = 0, BLANK (), v )
		formatString: #,0
		lineageTag: ed9855ed-d129-4a58-bd3a-2cba04360e9a

	measure 'Units On Order' =
			VAR v = SUM ( Products[UnitsOnOrder] )
			RETURN IF ( v = 0, BLANK (), v )
		formatString: #,0
		lineageTag: 192ba413-87fa-4aa8-828f-fb7e10f08978

	measure 'Reorder Level' =
			VAR v = SUM ( Products[ReorderLevel] )
			RETURN IF ( v = 0, BLANK (), v )
		formatString: #,0
		lineageTag: e3526790-2eee-4de3-9522-89d7685babbb

	measure 'Stock Status' =
			VAR InStock = SUM ( Products[UnitsInStock] )
			VAR Reorder = SUM ( Products[ReorderLevel] )
			VAR InStockPlusOrdered = SUM ( Products[StockPlusOrdered] )
			RETURN
			    IF (
			        HASONEVALUE ( Products[ProductID] ),
			        SWITCH (
			            TRUE (),
			            InStock = 0 && InStockPlusOrdered = 0, "Out of stock",
			            InStock = 0, "Out of stock (on order)",
			            InStockPlusOrdered < Reorder, "Reorder needed",
			            InStock < Reorder, "Below reorder level (on order)",
			            "OK"
			        )
			    )
		lineageTag: 0e1a46a2-6f6f-4687-b2d1-b5882ac2b63e

	measure 'Details Title' = "Product Details: " & SELECTEDVALUE ( Products[ProductName], "Select a product" )
		lineageTag: 5e8b3c7a-3b7c-44a6-871b-d2f8925dac56

